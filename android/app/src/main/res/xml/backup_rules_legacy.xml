<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.x (docs/06 B.5): bez garancie sifrovania zalohy sa nezalohuje
     nic (requireFlags funguje az od Android 9, pre 9+ plati xml-v28). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
