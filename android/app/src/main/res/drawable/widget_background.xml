<?xml version="1.0" encoding="utf-8"?>
<!-- W-01: pozadie widgetu (lesteny mramor / atramentova noc), zaoblene
     rohy podla systemu na Androide 12+ (values-v31/widget_dimens.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
