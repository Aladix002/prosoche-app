<?xml version="1.0" encoding="utf-8"?>
<!-- W-01: velky widget (4x2): meander v hlavicke (nie pod textom,
     docs/DESIGN.md 5.3), citat, referencia s autorom, pri dostatocnej
     vyske prekladatel a "Read in context". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/widget_meander" />

        <TextView
            android:id="@+id/widget_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="19sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="start|center_vertical"
        android:lineSpacingMultiplier="1.12"
        android:maxLines="8"
        android:textColor="@color/widget_lead" />

    <TextView
        android:id="@+id/widget_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_translator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/widget_tertiary"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_read"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_primary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
