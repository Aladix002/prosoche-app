  "blkPermTitle": "Permissions for the gate",
  "@blkPermTitle": {
    "description": "O6 title and title of the permissions screen in settings."
  },
  "blkPermIntro": "Prosoche checks which app is open, only to show the gate. This never leaves your phone.",
  "@blkPermIntro": {
    "description": "O6 intro, part of the prominent disclosure."
  },
  "permUsageTitle": "Usage access",
  "@permUsageTitle": {
    "description": "Name of the Android usage access permission."
  },
  "permUsageBody": "Prosoche uses Usage Access to notice when you open one of the apps you chose for the gate, so it can show your cards first.",
  "@permUsageBody": {
    "description": "Prominent disclosure for usage access (Google Play)."
  },
  "permUsageDoes": "What Prosoche does: checks which app is on screen, only while your screen is on.",
  "@permUsageDoes": {
    "description": "Prominent disclosure: what is done with usage access."
  },
  "permUsageNever": "What Prosoche never does: it doesn't store or send your app history, time spent, or anything you do inside other apps.",
  "@permUsageNever": {
    "description": "Prominent disclosure: what is never done."
  },
  "permUsageSteps": "On the next screen, find Prosoche and turn on \"Permit usage access\". Then come back.",
  "@permUsageSteps": {
    "description": "Steps in system settings for usage access."
  },
  "permOverlayTitle": "Display over other apps",
  "@permOverlayTitle": {
    "description": "Name of the Android overlay permission."
  },
  "permOverlayBody": "This lets Prosoche open its gate screen on top of the app you just opened.",
  "@permOverlayBody": {
    "description": "Prominent disclosure for the overlay permission."
  },
  "permOverlayNever": "What Prosoche never does: read, record or change what's on your screen.",
  "@permOverlayNever": {
    "description": "Prominent disclosure: what is never done with overlay."
  },
  "permNotifTitle": "Notifications",
  "@permNotifTitle": {
    "description": "Name of the notification permission."
  },
  "permNotifBody": "While the gate is on, Android shows a small, silent notification. It means Prosoche is ready to pause the apps you chose.",
  "@permNotifBody": {
    "description": "Why notifications matter for the gate (foreground service)."
  },
  "permLocal": "This stays on your phone and is not shared with anyone.",
  "@permLocal": {
    "description": "Prominent disclosure: data is not shared."
  },
