  "batteryGuide": "Guide",
  "@batteryGuide": {
    "description": "Button that opens the battery guide."
  },
  "batteryBodyGeneric": "Some phones stop apps running in the background to save battery. If the gate stops appearing, allow Prosoche to run in the background.",
  "@batteryBodyGeneric": {
    "description": "Generic battery guide."
  },
  "batteryBodyVendor": "{manufacturer} phones often stop background apps. These steps keep the gate working:",
  "@batteryBodyVendor": {
    "description": "Intro of the vendor battery guide.",
    "placeholders": {
      "manufacturer": {
        "type": "String"
      }
    }
  },
  "batteryStepsSamsung": "1. Open battery settings below.\n2. Find Prosoche and choose \"Unrestricted\".\n3. In Settings > Battery > Background usage limits, make sure Prosoche is not in \"Sleeping apps\".",
  "@batteryStepsSamsung": {
    "description": "Battery guide steps for Samsung (One UI). Check the paths on current devices."
  },
  "batteryStepsXiaomi": "1. Open battery settings below.\n2. Find Prosoche and choose \"No restrictions\".\n3. In the app info of Prosoche, turn on \"Autostart\".",
  "@batteryStepsXiaomi": {
    "description": "Battery guide steps for Xiaomi, Redmi, POCO (HyperOS/MIUI). Check the paths on current devices."
  },
  "batteryStepsHuawei": "1. Open battery settings below.\n2. Find Prosoche in App launch and turn off \"Manage automatically\".\n3. Allow auto-launch and running in background.",
  "@batteryStepsHuawei": {
    "description": "Battery guide steps for Huawei and Honor. Check the paths on current devices."
  },
  "batteryStepsOppo": "1. Open battery settings below.\n2. Find Prosoche and allow background activity.\n3. In the app info of Prosoche, turn on \"Allow auto launch\".",
  "@batteryStepsOppo": {
    "description": "Battery guide steps for Oppo, Realme, OnePlus (ColorOS). Check the paths on current devices."
  },
