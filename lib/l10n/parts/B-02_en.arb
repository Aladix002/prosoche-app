{
  "@@locale": "en",
  "gatePauseTitle": "A pause before {app}",
  "@gatePauseTitle": {
    "description": "Gate header before a blocked app. {app} is the app name, e.g. 'A pause before Instagram'. Never judge the app or the user.",
    "placeholders": {"app": {"type": "String"}}
  },
  "gatePauseTitleGeneric": "A pause before this app",
  "@gatePauseTitleGeneric": {"description": "Gate header when the app name is unknown."},
  "gateSubtitle": "{count, plural, one{1 card, then {app} opens.} other{{count} cards, then {app} opens.}}",
  "@gateSubtitle": {
    "description": "Gate subtitle: how many cards before the app opens.",
    "placeholders": {"count": {"type": "int"}, "app": {"type": "String"}}
  },
  "gateSubtitleGeneric": "{count, plural, one{1 card, then the app opens.} other{{count} cards, then the app opens.}}",
  "@gateSubtitleGeneric": {
    "description": "Gate subtitle when the app name is unknown.",
    "placeholders": {"count": {"type": "int"}}
  },
  "gateProgress": "{done} of {total}",
  "@gateProgress": {
    "description": "Screen reader progress of the gate cards, e.g. '1 of 3'.",
    "placeholders": {"done": {"type": "int"}, "total": {"type": "int"}}
  },
  "gateNext": "Next",
  "@gateNext": {"description": "Button that moves to the next card in the gate."},
  "gateDwellLeft": "{seconds} s",
