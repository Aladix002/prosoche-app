    "placeholders": {"prayer": {"type": "String"}}
  },
  "gatePrayerBody": "{app} will still be here after you pray.",
  "@gatePrayerBody": {
    "description": "Prayer reminder text.",
    "placeholders": {"app": {"type": "String"}}
  },
  "gatePrayerBodyGeneric": "The app will still be here after you pray.",
  "@gatePrayerBodyGeneric": {"description": "Prayer reminder text when the app name is unknown."},
  "gatePrayerPray": "I'll pray first",
  "@gatePrayerPray": {"description": "Goes to the home screen."},
  "gatePrayerContinue": "Show cards anyway",
  "@gatePrayerContinue": {"description": "Continues to the normal gate with cards."},
  "gateErrorTitle": "We couldn't load your cards",
  "@gateErrorTitle": {"description": "Gate error state (database or timeout)."},
  "gateErrorBody": "This is our mistake, not yours. You can continue.",
  "@gateErrorBody": {"description": "Gate error body."},
  "gateLoadingSlow": "Still loading…",
  "@gateLoadingSlow": {"description": "Shown when the gate takes long to load."},
  "gateEmpty": "Nothing to show right now. {app} is open.",
  "@gateEmpty": {
    "description": "Gate empty state; the app will open.",
    "placeholders": {"app": {"type": "String"}}
  },
  "gateEmptyGeneric": "Nothing to show right now. The app is open.",
  "@gateEmptyGeneric": {"description": "Gate empty state when the app name is unknown."}
}
