  "gateEmergency": "Emergency",
  "@gateEmergency": {"description": "Hold-to-confirm button that opens the app without cards after a 10 second countdown."},
  "gateEmergencyTitle": "Opening {app}",
  "@gateEmergencyTitle": {
    "description": "Title of the emergency countdown.",
    "placeholders": {"app": {"type": "String"}}
  },
  "gateEmergencyTitleGeneric": "Opening the app",
