  "@gateEmergencyA11yDialog": {
    "description": "Dialog shown instead of hold-to-confirm when a screen reader is on.",
    "placeholders": {"app": {"type": "String"}, "minutes": {"type": "int"}}
  },
  "gateEmergencyA11yDialogGeneric": "Open the app without cards? It opens in 10 seconds for {minutes} minutes.",
  "@gateEmergencyA11yDialogGeneric": {
    "description": "Screen reader emergency dialog when the app name is unknown.",
    "placeholders": {"minutes": {"type": "int"}}
  },
  "gateUnlockedTitle": "{minutes, plural, one{{app} is open for 1 minute} other{{app} is open for {minutes} minutes}}",
