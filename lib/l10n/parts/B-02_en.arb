    "description": "Shown after the required cards.",
    "placeholders": {"app": {"type": "String"}, "minutes": {"type": "int"}}
  },
  "gateUnlockedTitleGeneric": "{minutes, plural, one{The app is open for 1 minute} other{The app is open for {minutes} minutes}}",
