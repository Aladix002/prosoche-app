    {
      "name": "source",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"source\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"lang\" TEXT NULL, \"name\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"license\" TEXT NOT NULL, \"license_url\" TEXT NULL, \"license_text\" TEXT NOT NULL, \"attribution\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"commercial_status\" TEXT NOT NULL, \"sha256\" TEXT NULL, PRIMARY KEY (\"id\"));"
