    {
      "name": "meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "source",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"source\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"translator\" TEXT NULL, \"translator_died\" INTEGER NULL, \"edition_year\" INTEGER NULL, \"version\" TEXT NOT NULL, \"license\" TEXT NOT NULL, \"license_note\" TEXT NOT NULL, \"attribution\" TEXT NOT NULL, \"url\" TEXT NULL, \"sha256\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "author",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"author\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"full_name\" TEXT NOT NULL, \"lifespan\" TEXT NOT NULL, \"ord\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "work",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"work\" (\"id\" TEXT NOT NULL, \"author_id\" TEXT NOT NULL REFERENCES author (id), \"source_id\" TEXT NOT NULL REFERENCES source (id), \"title\" TEXT NOT NULL, \"original_title\" TEXT NOT NULL, \"translator\" TEXT NOT NULL, \"short_ref\" TEXT NOT NULL, \"book_count\" INTEGER NOT NULL, \"section_count\" INTEGER NOT NULL, \"ord\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "book",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book\" (\"work_id\" TEXT NOT NULL REFERENCES work (id), \"number\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"section_count\" INTEGER NOT NULL, PRIMARY KEY (\"work_id\", \"number\"));"
        }
      ]
    },
    {
      "name": "section",
