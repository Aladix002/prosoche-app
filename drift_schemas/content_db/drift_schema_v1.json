    {
      "name": "quote",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quote\" (\"id\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"origin\" TEXT NOT NULL, \"text\" TEXT NOT NULL, \"author\" TEXT NOT NULL, \"work\" TEXT NOT NULL, \"ref\" TEXT NULL, \"tags\" TEXT NOT NULL, \"time_of_day\" TEXT NOT NULL DEFAULT 'any', \"weight\" REAL NOT NULL DEFAULT 1.0, \"source_id\" TEXT NOT NULL REFERENCES source (id), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "quest_template",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quest_template\" (\"id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"status\" TEXT NOT NULL, \"origin\" TEXT NOT NULL, \"slot\" TEXT NOT NULL, \"rule_json\" TEXT NOT NULL, \"tags\" TEXT NOT NULL, \"facets_json\" TEXT NULL, \"weight\" REAL NOT NULL DEFAULT 1.0, \"cooldown_days\" INTEGER NOT NULL DEFAULT 21, \"reviewed_by\" TEXT NULL, \"reviewed_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
