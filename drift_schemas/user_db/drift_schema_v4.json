    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value_json\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "daily_set",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_set\" (\"date\" TEXT NOT NULL, \"seed\" INTEGER NOT NULL, \"cards_json\" TEXT NOT NULL, \"cursor\" INTEGER NOT NULL DEFAULT 0, \"started_at\" INTEGER NULL, \"completed_at\" INTEGER NULL, \"generator_version\" INTEGER NOT NULL, \"content_version\" TEXT NOT NULL, \"tz\" TEXT NOT NULL, \"phase\" TEXT NOT NULL CHECK(\"phase\" IN ('morning', 'day', 'evening', 'night')), PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "card_event",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_event\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" TEXT NOT NULL, \"card_id\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('intro', 'quote', 'passage', 'practice', 'prompt', 'concept', 'author', 'done')), \"context\" TEXT NOT NULL CHECK(\"context\" IN ('feed', 'gate', 'reader', 'saved')), \"action\" TEXT NOT NULL CHECK(\"action\" IN ('seen', 'answered', 'saved', 'unsaved', 'skipped', 'shared', 'source_opened', 'reported')), \"pos\" INTEGER NULL, \"value\" INTEGER NULL, \"correct\" INTEGER NULL CHECK (\"correct\" IN (0, 1)), \"ts\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "quest_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quest_log\" (\"date\" TEXT NOT NULL, \"slot\" TEXT NOT NULL CHECK(\"slot\" IN ('read', 'learn', 'act')), \"quest_id\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'open' CHECK(\"status\" IN ('open', 'done', 'skipped')), \"done_at\" INTEGER NULL, PRIMARY KEY (\"date\", \"slot\"));"
        }
      ]
    },
    {
      "name": "day_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_log\" (\"date\" TEXT NOT NULL, \"status\" TEXT NOT NULL CHECK(\"status\" IN ('done', 'grace', 'missed', 'excused')), \"sources\" TEXT NULL, PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "streak_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"streak_state\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"current\" INTEGER NOT NULL DEFAULT 0, \"longest\" INTEGER NOT NULL DEFAULT 0, \"grace_left\" INTEGER NOT NULL DEFAULT 0, \"grace_refill_at\" TEXT NULL, \"last_evaluated_date\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "blocked_app",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"blocked_app\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"platform_ref\" TEXT NOT NULL UNIQUE, \"label\" TEXT NULL, \"cards_required\" INTEGER NOT NULL DEFAULT 3, \"unlock_minutes\" INTEGER NOT NULL DEFAULT 10, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"practice_first\" INTEGER NOT NULL DEFAULT 1 CHECK (\"practice_first\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "gate_session",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gate_session\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"blocked_app_id\" INTEGER NULL REFERENCES blocked_app (id) ON DELETE SET NULL, \"opened_at\" INTEGER NOT NULL, \"closed_at\" INTEGER NULL, \"cards_seen\" INTEGER NOT NULL DEFAULT 0, \"result\" TEXT NULL CHECK(\"result\" IN ('passed', 'emergency', 'dismissed', 'error')), \"intent\" TEXT NULL CHECK(\"intent\" IN ('boredom', 'message', 'work', 'habit', 'other')));"
        }
      ]
